  "faqs": [
    {
      "_key": "faq-0",
      "question": "What ingredients does Vorix supply?",
      "answer": "We supply dehydrated white, pink and red onion, garlic, fried onion and garlic, and spices, herbs and seasonings."
    },
    {
      "_key": "faq-1",
      "question": "Where are Vorix ingredients sourced and made?",
      "answer": "Our ingredients are sourced close to the crop and processed in Mahuva, Gujarat, with controlled dehydration, sorting and packing."
    },
    {
      "_key": "faq-2",
      "question": "Which formats are available?",
      "answer": "Depending on the product, formats include flakes, chopped, minced, granules, powder, fried formats and custom blends."
    },
    {
      "_key": "faq-3",
      "question": "Can Vorix support export requirements?",
      "answer": "Yes. We work with food makers in India and international markets and can discuss specifications, documentation and production planning."
    },
    {
      "_key": "faq-4",
      "question": "How do I request a sample or quotation?",
      "answer": "Use the inquiry form on the homepage or email hussain@nexusfoods.co.in for domestic enquiries and hasan@nexusfoods.co.in for export enquiries."
    }
  ],
